#!/bin/sh
set -e

DKMS_NAME="aic8800d80-recovery"
DKMS_VERSION="1.0.0"

case "$1" in
    configure)
        if [ ! -x /usr/lib/dkms/common.postinst ]; then
            echo "DKMS integration helper is unavailable." >&2
            exit 1
        fi

        /usr/lib/dkms/common.postinst \
            "$DKMS_NAME" \
            "$DKMS_VERSION" \
            /usr/share/aic8800d80-recovery-dkms \
            "" \
            "${2:-}"

        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules || true
        fi

        echo
        echo "AIC8800D80 modules were installed on disk but were not loaded."
        echo "Connect or activate the adapter only after running the safety check."
        ;;
esac

exit 0
