#!/bin/sh
set -e

DKMS_NAME="aic8800d80-recovery"
DKMS_VERSION="1.0.0"

case "$1" in
    remove|upgrade|deconfigure)
        if command -v dkms >/dev/null 2>&1 && \
           dkms status -m "$DKMS_NAME" -v "$DKMS_VERSION" 2>/dev/null |
               grep -q .; then
            dkms remove -m "$DKMS_NAME" -v "$DKMS_VERSION" --all
        fi
        ;;
esac

exit 0
